# Servidor Baileys (copie para wa-server/.env ou passe como variáveis do container)
HOST=0.0.0.0
PORT=3001

# Obrigatório: todas as rotas exigem x-api-key igual a este valor.
API_KEY=gere_uma_chave_longa_e_aleatoria_aqui

# Diretório da sessão do WhatsApp. Em produção, aponte para um volume persistente.
SESSION_DIR=/app/session

# Webhook do painel (Vercel ou servidor local).
WEBHOOK_URL=https://SEU-PAINEL.vercel.app/api/whatsapp/webhook
WEBHOOK_SECRET=mesmo_valor_do_WEBHOOK_SECRET_do_painel

# Fila: intervalo aleatório entre envios e limite por minuto.
QUEUE_MIN_DELAY_MS=3000
QUEUE_MAX_DELAY_MS=8000
MAX_ENVIO_POR_MINUTO=20

# Nível de log do pino.
LOG_LEVEL=info
