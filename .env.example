HOST=127.0.0.1
PORT=3000
PG_HOST=127.0.0.1
PG_PORT=5433
PG_USER=n8n
PG_DATABASE=n8n
PG_PASSWORD=COLOQUE_A_SENHA_DO_POSTGRES_AQUI
# Para WhatsApp Cloud API local, use meta; mantenha baileys para conexão por QR.
WHATSAPP_PROVIDER=baileys
# Exigida ao definir HOST como 0.0.0.0 ou outro endereco acessivel pela rede.
# API_KEY=gere_uma_chave_longa_e_aleatoria

# WhatsApp Cloud API oficial (local ou Vercel)
# META_WA_ACCESS_TOKEN=
# META_WA_PHONE_NUMBER_ID=
# META_WA_GRAPH_VERSION=v27.0
# META_WA_TEMPLATE_NAME=sentry_camera_offline
# META_WA_TEMPLATE_LANGUAGE=pt_BR
# Obrigatórios no servidor local para validar o webhook HTTPS da Meta.
# META_WA_APP_SECRET=
# META_WA_VERIFY_TOKEN=gere_um_segredo_longo_e_aleatorio
# META_WA_TENANT_ID=default
# META_WA_TIMEOUT_MS=15000

# Servidor Baileys persistente (preferencial; substitui a ponte legada abaixo)
# WA_SERVER_URL=https://wa-server.seu-dominio.example
# WA_API_KEY=gere_uma_chave_longa_e_aleatoria
# Mesmo segredo configurado no wa-server para assinar os webhooks.
# WEBHOOK_SECRET=gere_outro_segredo_longo_e_aleatorio
# Sem confirmação do webhook neste tempo, o alerta aparece como "sem confirmação".
# WA_CONFIRM_TIMEOUT_MINUTES=15

# Ponte HTTPS legada (usada apenas se WA_SERVER_URL/WA_API_KEY não estiverem definidos)
# WHATSAPP_BRIDGE_URL=https://seu-servidor.example
# WHATSAPP_BRIDGE_KEY=mesma_chave_da_API_KEY_do_servidor
